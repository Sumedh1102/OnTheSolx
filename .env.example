# ── Database ────────────────────────────────────────────────
# Postgres 14+ with the btree_gist extension available (Neon, Supabase, RDS, Render all have it).
# On serverless hosts use the provider's pooled connection string (e.g. Neon's "-pooler" host).
DATABASE_URL="postgres://smashpoint:smashpoint@localhost:5432/smashpoint"
# Optional: connections per app instance (default 10, or 5 on Vercel).
# DATABASE_POOL_MAX="10"

# ── Auth ────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32   (changing it signs everyone out)
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Public URL of the site (metadata, sitemap, receipts, emails, payment callbacks).
# On Vercel it defaults to the project's production domain if left unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── First deploy (read by `npm run db:deploy`) ──────────────
# Creates this admin account if it doesn't exist yet. Change the password after signing in.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Academy Admin"
# Public demo only: load the demo academy into an EMPTY database (never touches real data).
SEED_DEMO_DATA="false"
# Public demo only: shows one-click demo accounts on /login and allows the sandbox gateway.
DEMO_MODE="false"

# ── Payments ────────────────────────────────────────────────
# mock | razorpay. Production refuses to start with "mock" unless DEMO_MODE=true.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Notifications (optional; unset channels are skipped and logged) ──
EMAIL_FROM="SmashPoint Academy <hello@smashpoint.in>"
RESEND_API_KEY=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# ── Scheduled jobs ──────────────────────────────────────────
# Protects /api/cron/reminders (called with: Authorization: Bearer <CRON_SECRET>).
# Generate with: openssl rand -hex 24
CRON_SECRET="change-me"
