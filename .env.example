# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgres://smashpoint:smashpoint@localhost:5432/smashpoint"

# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Public URL of the site (used for metadata, sitemap, receipts & payment callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payments ────────────────────────────────────────────────
# mock | razorpay   (add more adapters in src/server/payments/providers)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Notifications (all optional — channels log to console when unset) ──
EMAIL_FROM="SmashPoint Academy <hello@smashpoint.in>"
RESEND_API_KEY=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# Protects /api/cron/* (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me"
